{
  "editor.formatOnSave": true,
  "files.associations": { "*.winget": "yaml" },
  "yaml.schemas": {
    "https://aka.ms/configuration-dsc-schema/0.2": ["**/*.winget"]
  },
  "python.defaultInterpreterPath": "${workspaceFolder}\\samples\\python-emi-api\\.venv\\Scripts\\python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}\\samples\\python-emi-api",
  "python.testing.pytestArgs": ["tests"],
  // Remove this override where licensed Docker Desktop is the approved standard.
  "dev.containers.dockerPath": "wslc"
}
