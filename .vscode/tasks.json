{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cleanup preview",
      "detail": "After setup/app/test tasks finish: read-only ownership plan; no uninstalls or reset.",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cleanup.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Cleanup generated resources",
      "detail": "HUMAN ONLY, after all tasks finish: exact owned files only, per-target confirmation. Containers remain unless separately opted in.",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cleanup.ps1", "-Apply", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Preflight",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Preflight", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}"],
      "problemMatcher": []
    },
    {
      "label": "Setup preview",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "SetupPreview", "-SetupModule", "${input:setupModule}", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}"],
      "problemMatcher": []
    },
    {
      "label": "User-run setup",
      "detail": "HUMAN ONLY: choose ONE installed-first module. Existing tools never downloaded/upgraded; no Microsoft bundle. Use named extension task only after source approval.",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Setup", "-SetupModule", "${input:setupModule}", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}", "-InstallTimeoutSeconds", "${input:installTimeoutSeconds}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Finish setup",
      "detail": "LEGACY ONLY: broad add-on after confirmed successful Microsoft bundle and reboot/resume. Never use for a stopped partial base or normal modular setup.",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "FinishSetup", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Legacy Microsoft bundle (optional)",
      "detail": "EXPLICIT OPT-IN: broad upstream preset may redownload installed software and tweak Windows/profile/fonts. Not the default installed-first modules.",
      "type": "process", "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "LegacySetup", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}", "-BaseSetupTimeoutSeconds", "${input:baseSetupTimeoutSeconds}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Install core tools",
      "type": "process", "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Setup", "-SetupModule", "Core", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}", "-InstallTimeoutSeconds", "${input:installTimeoutSeconds}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Install Python SDK",
      "type": "process", "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Setup", "-SetupModule", "Python", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}", "-InstallTimeoutSeconds", "${input:installTimeoutSeconds}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Install Java SDK",
      "type": "process", "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Setup", "-SetupModule", "Java", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}", "-InstallTimeoutSeconds", "${input:installTimeoutSeconds}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Install Go SDK",
      "type": "process", "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Setup", "-SetupModule", "Go", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}", "-InstallTimeoutSeconds", "${input:installTimeoutSeconds}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Install extensions (approved source)",
      "detail": "HUMAN/IT must first confirm current VS Code CLI/default-profile approved marketplace routing. No profile/source changes or public VSIX fallback.",
      "type": "process", "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Setup", "-SetupModule", "Extensions", "-ExtensionSourceApproved", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}", "-InstallTimeoutSeconds", "${input:installTimeoutSeconds}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Install WSL components",
      "detail": "HUMAN: approved Administrator terminal required for feature inventory/changes. No distro/reset/update or automatic reboot; preserve existing runtime.",
      "type": "process", "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Setup", "-SetupModule", "WSL", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}", "-InstallTimeoutSeconds", "${input:installTimeoutSeconds}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Install Ubuntu (optional)",
      "detail": "Explicit distro opt-in after WSL/features/restart. Existing Ubuntu package/distro retained; never reset/unregister/start automatically.",
      "type": "process", "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Setup", "-SetupModule", "Ubuntu", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}", "-InstallTimeoutSeconds", "${input:installTimeoutSeconds}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Install Docker Desktop (licensed optional)",
      "detail": "HUMAN licensed opt-in only. Not a replacement after wslc policy/runtime denial.",
      "type": "process", "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Setup", "-SetupModule", "Docker", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}", "-InstallTimeoutSeconds", "${input:installTimeoutSeconds}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Install modernization (optional approved source)",
      "detail": "Explicit Java 11 / 13th extension, with approved marketplace routing; no default legacy upgrades.",
      "type": "process", "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Setup", "-SetupModule", "Modernization", "-ExtensionSourceApproved", "-HttpsTimeoutSeconds", "${input:httpsTimeoutSeconds}", "-InstallTimeoutSeconds", "${input:installTimeoutSeconds}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Verify",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\verify.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Restore project dependencies",
      "detail": "HUMAN ONLY: select Dependencies or ContainerImages, sample and approved runtime. Builds/restores happen here only, never in Run tasks.",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Restore", "-RestoreTarget", "${input:restoreTarget}", "-Sample", "${input:restoreSample}", "-Runtime", "${input:containerRuntime}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Restore Python",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Restore", "-Sample", "Python", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Restore Java",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Restore", "-Sample", "Java", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Restore Go",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Restore", "-Sample", "Go", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Restore PowerShell",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Restore", "-Sample", "PowerShell", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Test Python",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Test", "-Sample", "Python"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Coverage Python",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Coverage", "-Sample", "Python"],
      "problemMatcher": []
    },
    {
      "label": "Lint Python",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Lint", "-Sample", "Python"],
      "problemMatcher": []
    },
    {
      "label": "Test Java",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Test", "-Sample", "Java"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Coverage Java",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Coverage", "-Sample", "Java"],
      "problemMatcher": []
    },
    {
      "label": "Lint Java",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Lint", "-Sample", "Java"],
      "problemMatcher": []
    },
    {
      "label": "Test Go",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Test", "-Sample", "Go"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Coverage Go",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Coverage", "-Sample", "Go"],
      "problemMatcher": []
    },
    {
      "label": "Lint Go",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Lint", "-Sample", "Go"],
      "problemMatcher": []
    },
    {
      "label": "Test PowerShell",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Test", "-Sample", "PowerShell"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Coverage PowerShell",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Coverage", "-Sample", "PowerShell"],
      "problemMatcher": []
    },
    {
      "label": "Lint PowerShell",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Lint", "-Sample", "PowerShell"],
      "problemMatcher": []
    },
    {
      "label": "Test all samples",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Test", "-Sample", "All"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Coverage all samples",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Coverage", "-Sample", "All"],
      "problemMatcher": []
    },
    {
      "label": "Lint all samples",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Lint", "-Sample", "All"],
      "problemMatcher": []
    },
    {
      "label": "Test legacy Java (Java 11 opt-in)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "Test", "-Sample", "Legacy"],
      "problemMatcher": []
    },
    {
      "label": "Run EMI API (local)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "RunLocal", "-Sample", "Python", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Run EMI API (container)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "RunContainer", "-Sample", "Python", "-Runtime", "${input:containerRuntime}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Run IFSC service (local)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "RunLocal", "-Sample", "Java", "-Port", "8081", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Run IFSC service (container)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "RunContainer", "-Sample", "Java", "-Port", "8081", "-Runtime", "${input:containerRuntime}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Run FX rates (local)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "RunLocal", "-Sample", "Go", "-Port", "8082", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Run FX rates (container)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "RunContainer", "-Sample", "Go", "-Port", "8082", "-Runtime", "${input:containerRuntime}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Run legacy Java (container, opt-in)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "RunContainer", "-Sample", "Legacy", "-Port", "8083", "-Runtime", "${input:containerRuntime}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Reset demo",
      "detail": "HUMAN ONLY: protected reset to fetched safe origin/main; destructive sample/container confirmation in terminal, no automatic cleanup.",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\demo-reset.ps1", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "GitHub workflow status",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "WorkflowStatus"],
      "problemMatcher": []
    },
    {
      "label": "Deploy AKS (manual main only)",
      "detail": "HUMAN ONLY: current reviewed main SHA; requires live aks-demo approval protections, existing configured AKS.",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "DeployDispatch", "-SourceSha", "${input:mainSha}", "-Confirm"],
      "problemMatcher": []
    },
    {
      "label": "Kubernetes manifest check",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "KubernetesCheck"],
      "problemMatcher": []
    },
    {
      "label": "Kubernetes status",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "KubernetesStatus", "-Sample", "${input:kubernetesSample}", "-Namespace", "${input:kubernetesNamespace}"],
      "problemMatcher": []
    },
    {
      "label": "Kubernetes logs",
      "detail": "Current approved context; tail 100 lines for a fixed demo deployment.",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "KubernetesLogs", "-Sample", "${input:kubernetesSample}", "-Namespace", "${input:kubernetesNamespace}"],
      "problemMatcher": []
    },
    {
      "label": "Kubernetes port-forward",
      "detail": "HUMAN ONLY: foreground loopback 8080; stop with Ctrl+C.",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\developer.ps1", "-Action", "KubernetesPortForward", "-Sample", "${input:kubernetesSample}", "-Namespace", "${input:kubernetesNamespace}", "-Confirm"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    { "id": "httpsTimeoutSeconds", "type": "pickString", "description": "HTTPS seconds per attempt: 5 normal (default), 15 intermediate, 30 slow approved network; select again for setup/finish", "options": ["5", "15", "30"], "default": "5" },
    { "id": "baseSetupTimeoutSeconds", "type": "pickString", "description": "OPTIONAL LEGACY Microsoft base wait only: 7200=2h, 14400=4h, 28800=8h. Never rerun an active or stopped-partial base blindly.", "options": ["7200", "14400", "28800"], "default": "14400" },
    { "id": "installTimeoutSeconds", "type": "pickString", "description": "One missing target wait: 3600=1h, 7200=2h default, 14400=4h. Timeout may leave vendor installer active; never retry blindly.", "options": ["3600", "7200", "14400"], "default": "7200" },
    { "id": "setupModule", "type": "pickString", "description": "ONE independently retryable module; Core default is not Microsoft bundle. For Extensions/Modernization use their named approved-source tasks.", "options": ["Core", "Python", "Java", "Go", "Extensions", "WSL", "Ubuntu", "Docker", "Modernization"], "default": "Core" },
    { "id": "restoreTarget", "type": "pickString", "description": "Dependencies or explicit container image build/restore (Run never builds/pulls)", "options": ["Dependencies", "ContainerImages"], "default": "Dependencies" },
    { "id": "restoreSample", "type": "pickString", "description": "Explicit user-run restore (Legacy separately requires Java 11)", "options": ["Python", "Java", "Go", "PowerShell", "All", "Legacy"], "default": "All" },
    { "id": "containerRuntime", "type": "pickString", "description": "Already-approved runtime; auto prefers wslc, no fallback after denial", "options": ["auto", "wslc", "docker"], "default": "auto" },
    { "id": "mainSha", "type": "promptString", "description": "Reviewed CURRENT remote main commit SHA (40 lowercase hex characters)" },
    { "id": "kubernetesSample", "type": "pickString", "description": "Existing modern demo workload", "options": ["Python", "Java", "Go"], "default": "Python" },
    { "id": "kubernetesNamespace", "type": "promptString", "description": "Existing approved AKS_NAMESPACE (DNS label, no namespace creation)" }
  ]
}
