root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yaml,yml,winget}]
indent_size = 2

[*.{ps1,psm1,psd1,cmd}]
end_of_line = crlf

[*.go]
indent_style = tab

[*.md]
indent_size = 2
trim_trailing_whitespace = false
